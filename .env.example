# ---------------------------------------------------------------
# Desafío Camba — variables de entorno
# Copiá este archivo a `.env` (está en .gitignore) y completá los valores.
# En Vercel se cargan en Project → Settings → Environment Variables.
# ---------------------------------------------------------------

# Neon Postgres — connection string "pooled" del proyecto
# Dashboard de Neon → Connection Details → Pooled connection
DATABASE_URL=postgresql://usuario:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Firma de las sesiones JWT. Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Mínimo 32 caracteres.
JWT_SECRET=

# Semilla del primer super admin (solo la usan scripts/seed-superadmin.mjs).
# No hace falta configurarlas en Vercel si ya corriste el seed.
SUPERADMIN_EMAIL=admin@desafiocamba.bo
SUPERADMIN_PASSWORD=Cambiar.Esto.2026
SUPERADMIN_NAME=Super Admin

# Fase 2 — asistente IA (una clave por proveedor que quieras habilitar).
# Nunca se exponen al navegador: las llamadas salen desde las funciones de Vercel.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
# Ollama / LM Studio en local (opcional). Ej: http://127.0.0.1:11434/v1
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=
# Cualquier otro endpoint compatible con OpenAI
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=
